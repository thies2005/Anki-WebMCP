# ==============================================================================
# Anki-WebMCP Configuration Template
# Copy this file to .env and configure your secrets before deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Bootstrap (MANDATORY)
# ------------------------------------------------------------------------------
# Signs web portal/admin session cookies. The service REFUSES to start when
# this is empty or still the placeholder below.
# Generate with: openssl rand -hex 24
SESSION_SECRET=replace-with-openssl-rand-hex-24

# First-boot bootstrap only: when the user store is empty, the service creates
# this initial admin account on startup and refuses to start otherwise.
# Once the admin exists (further users are managed in the web UI at /admin),
# these two variables have no effect and can be removed from .env.
ADMIN_USERNAME=admin
# Use a strong password — this account can create users and view their tokens.
ADMIN_PASSWORD=

# Set true when serving HTTPS through a reverse proxy so session/flash cookies
# carry the Secure attribute (never sent over plain HTTP).
FORCE_SECURE_COOKIES=false
# Comma-separated proxy IPs whose X-Forwarded-For header is trusted when
# deriving the client IP (login rate limiting). Default trusts only the
# host's loopback. Behind cloudflared/Traefik, set this to the proxy/tunnel
# network — or "*" when the service is only reachable through the proxy
# (never "*" when the port is directly LAN-exposed: a spoofed header would
# let callers rotate their rate-limit identity).
FORWARDED_ALLOW_IPS=127.0.0.1

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
TZ=UTC
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Service Tuning (optional; defaults shown)
# ------------------------------------------------------------------------------
# When true, all write tools and AnkiWeb syncs are paused (reads still work).
MAINTENANCE_MODE=false
# Close a user's open collection after this many minutes of inactivity.
IDLE_TIMEOUT_MINUTES=15
# Maximum number of concurrently open per-user collections (LRU-bounded pool).
MAX_OPEN_COLLECTIONS=5
# Maximum simultaneous AnkiWeb sync operations across all users.
MAX_CONCURRENT_SYNCS=2
# Number of snapshots kept per user (pre-sync, pre-destructive-change, manual).
BACKUP_RETENTION=20
# Run a full two-way sync with AnkiWeb before every MCP tool call (accounts
# with saved AnkiWeb credentials only; fail-open — a failed sync never blocks
# the tool). This PUSHES pending local changes to AnkiWeb too; set false to
# keep mutations local until an explicit sync_collection.
SYNC_BEFORE_TOOLS=true
# Per-user cooldown for that sync, in seconds: the FIRST tool call in the
# window syncs with AnkiWeb, the rest run on local data (0 = sync every call).
SYNC_BEFORE_TOOLS_TTL_SECONDS=1800
# Maximum concurrent MCP sessions across ALL users (streamable-HTTP session table;
# new sessions get 503 past the cap until idle sessions are reaped).
MCP_MAX_SESSIONS=16
# Seconds an idle MCP session is retained before reaping.
MCP_SESSION_IDLE_TIMEOUT=300

# ------------------------------------------------------------------------------
# Exposure Mode 1: Cloudflare Tunnel (Optional)
# ------------------------------------------------------------------------------
# Required only if using docker-compose.cloudflare.yml
# Obtain from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# Exposure Mode 2: Coolify HTTPS Reverse Proxy (Optional)
# ------------------------------------------------------------------------------
# Required only if using docker-compose.coolify.yml
# Domain managed by Coolify's Traefik reverse proxy
ANKI_MCP_DOMAIN=anki-mcp.yourdomain.com

# ------------------------------------------------------------------------------
# Not configurable via environment
# ------------------------------------------------------------------------------
# Per-user MCP tokens, per-user AnkiWeb sync credentials, and additional user
# accounts are NOT set here: admins create users in the web UI (/admin), and
# each user manages their own token and AnkiWeb credentials in the portal.
# Everything above lives in the user store (<data volume>/users.json).
