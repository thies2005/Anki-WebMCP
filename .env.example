# ==============================================================================
# Anki-WebMCP Configuration Template
# Copy this file to .env and configure your secrets before deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Authentication (MANDATORY)
# ------------------------------------------------------------------------------
# Secret API key used for private communication between mcp-service and AnkiConnect.
# Generate with: openssl rand -hex 24
ANKI_CONNECT_API_KEY=replace-with-strong-random-ankiconnect-key

# Secret Bearer token required by AI clients connecting to https://<domain>/mcp
# AI clients must supply: "Authorization: Bearer <MCP_AUTH_TOKEN>"
# Generate with: openssl rand -hex 24
MCP_AUTH_TOKEN=replace-with-strong-random-mcp-bearer-token

# ------------------------------------------------------------------------------
# Desktop GUI Authentication (KasmVNC)
# ------------------------------------------------------------------------------
# HTTP Basic Auth credentials protecting the streamed desktop interface.
ANKI_GUI_USER=admin
ANKI_GUI_PASSWORD=replace-with-strong-gui-password

# ------------------------------------------------------------------------------
# Local Ports & Environment Defaults
# ------------------------------------------------------------------------------
ANKI_GUI_PORT=3000
MCP_PORT=8000
TZ=UTC
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Exposure Mode 1: Cloudflare Tunnel (Optional)
# ------------------------------------------------------------------------------
# Required only if using docker-compose.cloudflare.yml
# Obtain from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# Exposure Mode 2: Coolify HTTPS Reverse Proxy (Optional)
# ------------------------------------------------------------------------------
# Required only if using docker-compose.coolify.yml
# Domains managed by Coolify's Traefik reverse proxy
ANKI_GUI_DOMAIN=anki.yourdomain.com
ANKI_MCP_DOMAIN=anki-mcp.yourdomain.com

# ------------------------------------------------------------------------------
# Advanced Sync Server Override (Optional)
# ------------------------------------------------------------------------------
# By default, Anki Desktop syncs directly with the official AnkiWeb cloud account.
# Leave blank unless you operate an independent custom sync server.
ANKI_SYNC_SERVER=
