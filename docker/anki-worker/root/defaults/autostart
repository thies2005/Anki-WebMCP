#!/bin/bash
set -e

echo "[INFO] Initializing Anki Desktop environment..."

# Set HOME so Anki finds /config
export HOME=/config

# Qt / Chromium flags for containerized virtual display
export QTWEBENGINE_DISABLE_SANDBOX=1
export QT_QPA_PLATFORM=xcb
export QTWEBENGINE_CHROMIUM_FLAGS="--no-sandbox --disable-gpu --disable-software-rasterizer"

# Ensure data directories exist
mkdir -p /config/.local/share/Anki2/addons21
mkdir -p /config/.local/share/Anki2/backups

# Seed default prefs21.db if this is a fresh container volume to bypass language prompt
PREFS_TARGET="/config/.local/share/Anki2/prefs21.db"
if [ ! -f "$PREFS_TARGET" ] && [ -f "/defaults/prefs21.db" ]; then
    echo "[INFO] Seeding initial prefs21.db configuration..."
    cp /defaults/prefs21.db "$PREFS_TARGET"
fi

ADDON_DIR="/config/.local/share/Anki2/addons21/2055492159"
mkdir -p "$ADDON_DIR"

# Stage AnkiConnect files
if [ -d "/opt/anki-addons/2055492159" ]; then
    echo "[INFO] Synchronizing AnkiConnect add-on files..."
    cp -ru /opt/anki-addons/2055492159/* "$ADDON_DIR/" 2>/dev/null || cp -r /opt/anki-addons/2055492159/* "$ADDON_DIR/"
fi

# Write meta.json to bypass version check prompts
cat > "$ADDON_DIR/meta.json" << 'EOF'
{"disabled": false, "mod": 0, "conflicts": [], "max_point_version": 0, "min_point_version": 0, "branch_index": 0, "update_enabled": false}
EOF

# Configure AnkiConnect (webBindAddress=0.0.0.0, apiKey from environment)
API_KEY_VAL="${ANKI_CONNECT_API_KEY:-}"
if [ -z "$API_KEY_VAL" ]; then
    API_KEY_JSON="null"
else
    ESCAPED_KEY=$(echo "$API_KEY_VAL" | sed 's/"/\\"/g')
    API_KEY_JSON="\"$ESCAPED_KEY\""
fi

cat > "$ADDON_DIR/config.json" << EOF
{
    "apiKey": $API_KEY_JSON,
    "apiLogPath": null,
    "ignoreOriginList": [],
    "webBindAddress": "0.0.0.0",
    "webBindPort": 8765,
    "webCorsOriginList": ["*"]
}
EOF
echo "[INFO] AnkiConnect configured (binding: 0.0.0.0:8765, apiKey: $([ -z "$API_KEY_VAL" ] && echo "none" || echo "configured"))"

# Optional custom sync server override (official AnkiWeb is used by default)
if [ -n "$ANKI_SYNC_SERVER" ]; then
    cat > /config/.local/share/Anki2/prefs21.toml << EOF
[sync]
endpoint = "$ANKI_SYNC_SERVER"
EOF
    echo "[INFO] Custom sync server endpoint set to: $ANKI_SYNC_SERVER"
fi

echo "[INFO] Starting Anki Desktop process..."
while true; do
    anki --no-sandbox
    echo "[WARN] Anki Desktop process exited. Restarting in 3 seconds..."
    sleep 3
done
